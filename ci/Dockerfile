# CI image: Rust runs here, on the in-cluster BuildKit, because the ARC runner has no toolchain.
# Copied from dobbo-ca/deflate-rs ci/Dockerfile. Every tool is installed before `COPY . .`, so a
# new commit does not install it again.
FROM rust:1.99.1-bookworm AS toolchain
RUN rustup component add rustfmt clippy && rustup target add aarch64-unknown-linux-gnu
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install cargo-deny --locked --version ~0.18
WORKDIR /src

FROM toolchain AS src
COPY . .
# The regress goldens are committed gzipped; the tests read them unzipped (gositter-rs needs no gzip code).
RUN find testdata/regress -name '*.dump.gz' -exec gunzip -k {} +

# /src/target mounts are sharing=private: a build that finds the cache in use gets its own copy
# (new or older) instead of waiting for it (gositter-rs-768). ci/fresh.sh makes the sources newer
# than any artifact in such a copy, so it cannot give a stale green.
# --- Grammar tables (docs/superpowers/plans/2026-11-13-grammars.md, Task 5) ---

# The parser.c of each grammar module in grammars.lock, from the Go module proxy, in the Go module
# cache layout (<module>@<version>/<dir>/parser.c). Only the lock is copied, so BuildKit keeps this
# layer until the lock changes and a normal build does not download again. gengrammar checks each
# file's sha256 against the lock; a mismatch fails the build.
FROM toolchain AS gen-src
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*
COPY grammars/grammars.lock /gen/grammars.lock
RUN set -e; grep -v '^#' /gen/grammars.lock | while read -r pkg module version dir sum; do \
        [ -n "$pkg" ] || continue; \
        curl -fsSL --retry 3 "https://proxy.golang.org/$module/@v/$version.zip" -o /gen/m.zip; \
        unzip -q -o /gen/m.zip "$module@$version/$dir/parser.c" -d /parsers; \
    done; rm /gen/m.zip; test "$(find /parsers -name parser.c | wc -l)" -eq 21

# gengrammar over all 21 grammars. Its own target dir and no cache mount: the build is small, and a
# fresh build cannot reuse a stale binary from the shared target cache.
FROM src AS gen
COPY --from=gen-src /parsers /parsers
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    CARGO_TARGET_DIR=/gen-target cargo build --locked --release -p gengrammar \
    && /gen-target/release/gengrammar --lock grammars/grammars.lock --src /parsers --out /out -j 4

# The generated files only, for `outputs: type=local` (.github/workflows/gen.yml).
FROM scratch AS gen-out
COPY --from=gen /out /

# The committed grammar tables must be exactly what gen makes from grammars.lock (plan Task 5): a
# stale, missing or extra generated file fails `test` and is named. Regenerate with the gen job of
# .github/workflows/gen.yml and commit its artifact.
FROM src AS gen-check
COPY --from=gen /out /gen
RUN set -e; cd /gen; find . -type f | sort > /tmp/gen.list; bad=0; \
    while read -r f; do cmp -s "$f" "/src/grammars/$f" || { echo "gen-check: stale or missing: grammars/${f#./}"; bad=1; }; done < /tmp/gen.list; \
    cd /src/grammars; \
    { find . -name '*.bin' -path './*/*'; grep -l '^// @generated by gengrammar' ./*/*.rs || true; } | sort > /tmp/committed.list; \
    for f in $(comm -13 /tmp/gen.list /tmp/committed.list); do echo "gen-check: not generated any more: grammars/${f#./}"; bad=1; done; \
    test "$bad" = 0 && touch /ok

# The table oracle (plan Task 6): gositter v0.2.0's own generated Go tables, which gositter's check
# tool verified against C, written one file per Language field by gengrammar/oracle/tables. Pure
# Go (CGO_ENABLED=0); `go mod download` is checked against go.sum, and the build is -mod=readonly.
FROM golang:1.27-bookworm AS grammar-oracle
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOFLAGS=-mod=readonly
WORKDIR /oracle
COPY gengrammar/oracle/ ./
RUN test -z "$(gofmt -l .)" || { gofmt -l .; exit 1; }
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go vet ./... && go build -o /usr/local/bin/tables ./tables \
    && tables /oracle-out

# The lex oracle (plan Task 8): gositter v0.2.0's generated Go lex functions of bash, cpp, json and
# verilog on the mock lexer, written to /oracle-out/<g>.lex and <g>.lextext by gengrammar/oracle/lex
# (format in its main.go). They run against a fake gositter package: api.go as it is plus the mock
# lexer (mock.go) as its Lexer, and each grammar's tables.go, lex.go and language.go with the
# scanner stubbed, as gositter's cmd/gengrammar/check/run.sh does. Both Go files carry the build tag
# lexoracle, so the checks above do not see them; gofmt above covers them, go vet runs here.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    set -e; go mod download; \
    mod=$(go list -m -f '{{.Dir}}' github.com/dobbo-ca/gositter); \
    fake=/fake; mkdir -p $fake/gositter/grammars $fake/lexoracle; \
    printf 'module github.com/dobbo-ca/gositter\n\ngo 1.25\n' > $fake/gositter/go.mod; \
    cp --no-preserve=mode $mod/api.go $fake/gositter/api.go; \
    cp --no-preserve=mode lex/mock.go $fake/gositter/mock.go; \
    for g in bash cpp json verilog; do \
        mkdir $fake/gositter/grammars/$g; \
        for f in tables lex language; do cp --no-preserve=mode $mod/grammars/$g/$f.go $fake/gositter/grammars/$g/$f.go; done; \
        if grep -q 'New: *newScanner' $mod/grammars/$g/language.go; then \
            printf 'package %s\n\nimport "github.com/dobbo-ca/gositter"\n\nfunc newScanner() gositter.ExternalScanner { return nil }\n' $g > $fake/gositter/grammars/$g/zz_scanner.go; \
        fi; \
    done; \
    printf 'module lexoracle\n\ngo 1.25\n\nrequire github.com/dobbo-ca/gositter v0.0.0\n\nreplace github.com/dobbo-ca/gositter => ../gositter\n' > $fake/lexoracle/go.mod; \
    cp --no-preserve=mode lex/main.go $fake/lexoracle/main.go; \
    cd $fake/lexoracle; \
    go vet -tags lexoracle ./... && go build -tags lexoracle -o /usr/local/bin/lexoracle . \
    && lexoracle -tree $fake/gositter/grammars -regress $mod/testdata/regress -out /oracle-out \
    && ls -l /oracle-out/*.lex /oracle-out/*.lextext

# Our tables against the oracle, field by field, for all 21 grammars. gengrammar is the binary the
# gen stage built (its own target dir, no shared cache).
FROM gen AS grammar-parity
COPY --from=grammar-oracle /oracle-out /oracle-out
RUN /gen-target/release/gengrammar --lock grammars/grammars.lock --src /parsers --oracle /oracle-out
# The lex oracle (plan Task 8) against the Rust lexers: first the committed lex.rs (code form), then
# the table form, which gengrammar writes over grammars/<g>/lex.rs here (and lex.bin). Its own
# target dir and no cache mount, so nothing stale is reused.
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    CARGO_TARGET_DIR=/lex-target GRAMMAR_ORACLE=/oracle-out cargo test --locked --release -p gositter-grammars --test oracle_lex
RUN /gen-target/release/gengrammar --lock grammars/grammars.lock --src /parsers --out grammars --lexer table bash cpp json verilog
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    CARGO_TARGET_DIR=/lex-target GRAMMAR_ORACLE=/oracle-out cargo test --locked --release -p gositter-grammars --test oracle_lex

# The checks run in the build, so a red check fails the build; a rerun of the same source is a
# BuildKit cache hit.
FROM src AS ci
# The regeneration diff (gen-check) is part of `test`.
COPY --from=gen-check /ok /tmp/gen-ok
# fmt reads only the sources: no cache mount, so it never waits for one.
RUN cargo fmt --all --check
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,sharing=private \
    sh ci/fresh.sh && cargo clippy --locked --workspace --all-targets -- -D warnings
# No C in the build graph: the ban list in deny.toml.
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    cargo deny --locked check
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,sharing=private \
    sh ci/fresh.sh && cargo test --locked --workspace

# qemu-user and the aarch64 cross toolchain, for the arm64 stage.
FROM toolchain AS qemu-tools
RUN apt-get update && apt-get install -y --no-install-recommends qemu-user gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUNNER="qemu-aarch64 -L /usr/aarch64-linux-gnu"

FROM qemu-tools AS qemu-arm64
COPY . .
RUN find testdata/regress -name '*.dump.gz' -exec gunzip -k {} +

# The aarch64 lint and the full test suite for aarch64 under qemu-user. aarch64-only code (NEON
# kernels, unsigned C char) is not compiled for x86_64, so it is linted here; this runs on main and
# on dispatch, not on PRs (gositter-rs-jmw): an aarch64-only clippy error shows up after the merge.
FROM qemu-arm64 AS arm64
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,sharing=private \
    sh ci/fresh.sh && cargo clippy --locked --workspace --all-targets --target aarch64-unknown-linux-gnu -- -D warnings
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,sharing=private \
    sh ci/fresh.sh && cargo test --locked --workspace --target aarch64-unknown-linux-gnu
